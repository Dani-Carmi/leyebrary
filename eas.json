{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "public": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "LEYEBRARY_PUBLIC_BUILD": "true",
        "GOOGLE_BOOKS_API_URL": "https://www.googleapis.com/books/v1"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "personal": {
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    },   
    "personal-ios": {
      "distribution": "internal",
      "environment": "production"
    }   
  },
  "submit": {
    "production": {}
  }
}
